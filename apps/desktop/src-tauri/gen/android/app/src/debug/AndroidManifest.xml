        <receiver
            android:name=".VpnRuntimeDebugReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.odinone.desktop.vk.action.DEBUG_START_VPN_RUNTIME" />
