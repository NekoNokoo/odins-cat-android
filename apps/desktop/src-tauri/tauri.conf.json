{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odin One VK",
  "version": "0.5.2",
  "identifier": "com.odinone.desktop.vk",
  "build": {
    "beforeDevCommand": "zsh ./scripts/tauri-dev.sh",
    "beforeBuildCommand": "zsh ./scripts/desktop-env.sh npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Odin One",
        "width": 470,
        "height": 1040,
        "minWidth": 430,
        "minHeight": 920,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "acceptFirstMouse": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin"]
  }
}
