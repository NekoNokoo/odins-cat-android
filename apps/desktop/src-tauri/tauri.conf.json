{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odins Cat",
  "version": "1.0.0-beta",
  "identifier": "com.odinone.desktop.vk",
  "build": {
    "beforeDevCommand": "zsh ./scripts/tauri-dev.sh",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Odin's Cat",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "acceptFirstMouse": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "msi"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin"]
  }
}
